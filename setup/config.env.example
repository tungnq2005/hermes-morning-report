# ================================================================
# Cấu hình chung cho bộ script morning-brief-setup (D1 + D2 + D3).
# Sửa các giá trị cho đúng VPS của bạn RỒI chạy ./setup_all.sh
# Mọi script đều source file này, nên không còn hardcode user "ubuntu".
# ================================================================

# User Linux chạy OpenClaw (cài NATIVE, systemd user service — KHÔNG Docker).
# Mặc định = user đang chạy script. Trên VPS thường là "ubuntu"; máy khác có thể khác.
OC_USER="${OC_USER:-$(id -un)}"

# Thư mục home của user đó (tự dò; fallback /home/<user>).
OC_HOME="$(getent passwd "$OC_USER" 2>/dev/null | cut -d: -f6)"
: "${OC_HOME:=/home/$OC_USER}"

# Cổng gateway (loopback 127.0.0.1).
OC_PORT="${OC_PORT:-18789}"

# Múi giờ + giờ gửi morning report (dùng khi cấu hình cron production ở bước 07).
OC_TIMEZONE="${OC_TIMEZONE:-Asia/Ho_Chi_Minh}"
OC_DELIVERY_TIME="${OC_DELIVERY_TIME:-07:00}"

# Search provider tin tức. Giá trị hợp lệ: brave | exa | tavily | searxng | google | duckduckgo
# Mặc định brave (chính) + exa (dự phòng khi brave trả 429). Exa cần EXA_API_KEY.
# Nếu dùng tavily/google, nhớ thêm key tương ứng vào /etc/openclaw/openclaw.env (bước 03).
OC_SEARCH_PROVIDER="${OC_SEARCH_PROVIDER:-brave}"

# Không còn OC_REPO_URL: bước 06 lấy CẢ HAI skill từ chính repo này (thư mục ../skills),
# nên bản bạn clone về là bản được cài. Muốn cập nhật thì `git pull` rồi chạy lại bước 06.

# Telegram user id của chủ bot (command owner). Để trống nếu set sau qua chat pairing.
OC_OWNER_TELEGRAM_ID="${OC_OWNER_TELEGRAM_ID:-}"
